# ══════════════════════════════════════════════════════════════════════════════
# RateIQ .gitignore
# ══════════════════════════════════════════════════════════════════════════════
#
# PUSH TO GITHUB (kept in repo):
#   src/rateiq/*.py           — all source code
#   pyproject.toml            — dependency definitions
#   uv.lock                   — exact dependency versions (reproducible builds)
#   docker/docker-compose.yml — Docker setup
#   start_api.sh              — API startup script
#   main.py                   — entry point
#   README.md                 — project documentation
#   tests/                    — test files
#   notebooks/*.ipynb         — build documentation (how the system was made)
#   frontend/src/             — React source code
#   frontend/package.json     — frontend dependencies
#   .python-version           — Python version pin
#
# NOT PUSHED (ignored below):
#   .env                      — API keys (NEVER push)
#   data/raw/                 — confidential client BOQ files
#   data/processed/           — derived/generated data (large files)
#   data/embeddings/          — vector embeddings (regeneratable)
#   logs/ + *.log             — runtime logs
#   frontend/node_modules/    — npm packages (reinstall via: npm install)
#   frontend/dist/            — build output (rebuild via: npm run build)
#   .venv/                    — virtual environment (restore via: uv sync)
# ══════════════════════════════════════════════════════════════════════════════


# ── CRITICAL: API Keys & Secrets ──────────────────────────────────────────────
# NEVER commit these — contains OPENAI_API_KEY, ANTHROPIC_API_KEY, TAVILY_API_KEY
.env
.env.*
.env.local
.env.production
*.env
# EXCEPT .env.example — this is a safe template that CAN be committed
!.env.example


# ── Python: Bytecode & Cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python


# ── Python: Build & Distribution ─────────────────────────────────────────────
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST


# ── Python: Virtual Environment ──────────────────────────────────────────────
# Reproducible with: uv sync
.venv/
venv/
env/
ENV/


# ── Python: Tool Caches ───────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/


# ── Data: Client BOQ Files (CONFIDENTIAL) ────────────────────────────────────
# Raw Excel files are confidential tender data from clients.
# Also large (50KB–2MB each) — no value tracking in git.
# To restore: copy original Excel files back into data/raw/
data/raw/

# Windows metadata files (created when copying files from Windows to WSL)
*.xlsx:Zone.Identifier
*.xls:Zone.Identifier


# ── Data: Processed & Generated Files ────────────────────────────────────────
# Generated by running the ingestion pipeline (notebooks 01–03).
# To restore: run notebooks 01_boq_parser → 02_chunking → 03_embeddings_qdrant
# data/processed/boq_chunks.csv   ← NEEDED in Docker image for BM25 search
data/processed/boq_chunks.json
data/processed/boq_line_items.csv
data/processed/ingestion_checkpoint.json

# Vector embeddings — large binary files, regenerated by embedder.py
data/embeddings/


# ── Logs & Runtime Files ──────────────────────────────────────────────────────
logs/
*.log
api.log


# ── Frontend: Node Modules & Build ───────────────────────────────────────────
# node_modules : reinstall with → npm install
# dist         : rebuild with   → npm run build
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local


# ── Editor & IDE ─────────────────────────────────────────────────────────────
.kilo/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ── Temporary Files ───────────────────────────────────────────────────────────
reading.txt
*.tmp
*.temp
tmp/
temp/
